# Application
NODE_ENV=development
PORT=5000
JWT_SECRET=replace-with-a-long-random-secret
SESSION_ENCRYPT_KEY=replace-with-a-long-random-session-key

# PostgreSQL
# Railway: use the DATABASE_URL provided by the PostgreSQL service
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_audit
# Set to disable only for local environments without SSL
PGSSLMODE=disable

# Redis / BullMQ
# Railway: use the REDIS_URL provided by the Redis service
REDIS_URL=redis://localhost:6379

# Cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# OpenAI
OPENAI_API_KEY=sk-your_openai_key

# Google APIs (Sheets + Search Console)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REFRESH_TOKEN=your_google_refresh_token

# Airtable
AIRTABLE_API_KEY=pat_your_airtable_token
AIRTABLE_BASE_ID=appXXXXXXXXXXXXXX
AIRTABLE_TABLE_ID=tblXXXXXXXXXXXXXX

# Google Slides generation webhook
GOOGLE_SLIDES_WEBHOOK_URL=https://primary-production-2eb79.up.railway.app/webhook-test/4f510189-32ea-4c74-af0f-2786b57308cf

# Railway platform variables are usually injected automatically.
# RAILWAY_STATIC_URL=
# RAILWAY_ENVIRONMENT=
